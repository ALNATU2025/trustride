rules_version = '2';

// TrustRide Firestore security rules.
// Publish in Firebase console → Firestore Database → Rules
// (not Realtime Database), or with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }
    function isApprovedDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(uid()))
        && get(/databases/$(database)/documents/drivers/$(uid())).data.status == 'approved';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function inTrip(tripId) {
      return signedIn() && (tripDoc(tripId).riderId == uid() || tripDoc(tripId).driverId == uid());
    }

    // Prices and business settings: everyone reads, admins edit.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rider profiles. Only admins can change someone's role.
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'rider';
      allow update: if isAdmin()
        || (signedIn() && uid() == userId && !changed().hasAny(['role']));
      allow delete: if false;
    }

    // Driver applications, payment account and live location.
    match /drivers/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == driverId
        && request.resource.data.status == 'pending'
        && request.resource.data.ratingCount == 0
        && request.resource.data.commissionPaid == 0;
      allow update: if isAdmin()
        // driver edits own details / online / location / photo
        || (signedIn() && uid() == driverId
            && !changed().hasAny(['status', 'rejectReason', 'ratingSum', 'ratingCount', 'commissionPaid']))
        // driver re-applies after a rejection
        || (signedIn() && uid() == driverId && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && !changed().hasAny(['ratingSum', 'ratingCount', 'commissionPaid']))
        // a rider adds one rating of 1–5 stars
        || (signedIn() && changed().hasOnly(['ratingSum', 'ratingCount'])
            && request.resource.data.ratingCount == resource.data.ratingCount + 1
            && request.resource.data.ratingSum - resource.data.ratingSum >= 1
            && request.resource.data.ratingSum - resource.data.ratingSum <= 5);
      allow delete: if isAdmin();
    }

    // Trips.
    match /trips/{tripId} {
      allow read: if signedIn() && (
        resource.data.riderId == uid()
        || resource.data.driverId == uid()
        || isAdmin()
        || (resource.data.status == 'requested' && isApprovedDriver()));

      allow create: if signedIn()
        && request.resource.data.riderId == uid()
        && request.resource.data.status == 'requested'
        && request.resource.data.driverId == ''
        && request.resource.data.paid == false;

      allow update: if isAdmin()
        // rider changes their offer while still searching
        || (signedIn() && resource.data.riderId == uid()
            && resource.data.status == 'requested'
            && request.resource.data.status == 'requested'
            && changed().hasOnly(['fare', 'updatedAt']))
        // rider picks a driver's offer: driver and price must match that offer
        || (signedIn() && resource.data.riderId == uid()
            && resource.data.status == 'requested'
            && request.resource.data.status == 'accepted'
            && exists(/databases/$(database)/documents/trips/$(tripId)/offers/$(request.resource.data.driverId))
            && request.resource.data.fare == get(/databases/$(database)/documents/trips/$(tripId)/offers/$(request.resource.data.driverId)).data.price
            && changed().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'driverPhoto',
                                   'driverPlate', 'driverVehicle', 'driverRating', 'driverAccount',
                                   'fare', 'acceptedAt', 'updatedAt']))
        // rider: cancel, confirm payment, rate, tip, SOS — never fare or driver
        || (signedIn() && resource.data.riderId == uid()
            && changed().hasOnly(['status', 'cancelledBy', 'cancelledAt', 'paid', 'rating',
                                   'tags', 'comment', 'tip', 'sos', 'updatedAt'])
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'cancelled'))
        // assigned driver moves the trip along or confirms payment
        || (signedIn() && resource.data.driverId == uid()
            && changed().hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt', 'paid',
                                   'cancelledBy', 'cancelledAt', 'updatedAt']));
      allow delete: if false;

      // Drivers' prices for an open request.
      match /offers/{driverId} {
        allow read: if signedIn()
          && (tripDoc(tripId).riderId == uid() || driverId == uid() || isAdmin());
        allow create, update: if isApprovedDriver() && driverId == uid()
          && request.resource.data.driverId == uid()
          && request.resource.data.price > 0
          && tripDoc(tripId).status == 'requested';
        allow delete: if signedIn() && driverId == uid();
      }

      // Rider ↔ driver chat.
      match /messages/{messageId} {
        allow read: if inTrip(tripId) || isAdmin();
        allow create: if inTrip(tripId)
          && request.resource.data.from == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // Emergency alerts.
    match /sos/{id} {
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}
